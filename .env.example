# Subscription URLs (comma/newline-separated lists accepted in BOTH vars).
# All sources are fetched in parallel and merged; dead URLs are skipped
# automatically, so list a fast local URL first plus public fallbacks.
# V2RayDAR fetches configs from public repos: https://github.com/411A/V2RayDAR
#
# IMPORTANT: Inside Docker, 127.0.0.1 refers to the container itself, NOT your host.
# Use one of these instead:
#   http://host.docker.internal:27141/subscription  (Docker 20.10+, works on Mac/Win/Linux)
#   http://192.168.x.x:27141/subscription           (your host's LAN IP)
#
# WSL2: install.sh auto-detects WSL2 and replaces host.docker.internal with
# the Windows host IP. No manual config needed.
SUBSCRIPTION_URL=

# Additional subscription URLs (merged with SUBSCRIPTION_URL, same format).
# One per line inside double quotes (dead URLs are skipped automatically) or one-line separated with comma:
# SUBSCRIPTION_URLS="http://192.168.x.x:27141/subscription.txt
# https://raw.githubusercontent.com/0xRadikal/Free-v2ray-Configs/main/top100.txt
# https://sub3.example/subscription"

# URL used to test proxy connectivity (generate_204 or cp.cloudflare.com recommended)
HEALTH_CHECK_URL=https://www.gstatic.com/generate_204

# No proxy bypass for internal/LAN IPs (prevents routing local subscription requests through proxy)
NO_PROXY=127.0.0.1,localhost,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# Number of xray instances to run
PROXY_INSTANCES=1

# Base port for proxy allocation: N SOCKS5 ports first, then N HTTP ports
# Instance i of N -> SOCKS5=PORT_BASE+i, HTTP=PORT_BASE+N+i
PORT_BASE=27019

# Port for the HTTP API (returns live proxy list)
API_PORT=27018

# Path to xray binary directory (default: /root/xray)
# XRAY_DIR=/root/xray

# Go garbage collector target percentage (lower = more frequent GC, less memory)
# GOGC=100

# Go soft memory limit (prevents OOM by triggering aggressive GC)
# GOMEMLIMIT=128MiB

# Max concurrent HTTP CONNECT relay connections (prevents goroutine/memory explosion)
# MAX_CONNS=128

# Log level: info (default, only important logs) or debug (verbose + Xray logs)
# LOG_LEVEL=info

# --- IKEv2 + L2TP VPN gateway for legacy devices (Smart TVs, IoT, consoles) ---
# Single gateway on UDP 500/4500 (+1701 for L2TP). Client traffic is forced
# via tun0 into the fastest ALIVE Xray SOCKS (fail-closed: no direct egress).
# 0 = proxy-only (default, keeps old behavior). 1 = serve VPN.
VPN_ENABLED=0
# Public hostname/IP clients connect to (must match server cert; LAN IP ok).
# Connect using EXACTLY this name/IP (SAN-typed). Extra names/IPs (public +
# LAN) go in VPN_EXTRA_SANS so all of them validate.
VPN_DOMAIN=vpn.local
# VPN_EXTRA_SANS=203.0.113.7,192.168.1.10
# VPN client pools + pushed DNS (DNS also goes through the working proxy).
VPN_SUBNET=10.10.10.0/24
VPN_L2TP_NET=10.10.11.0/24
VPN_DNS=1.1.1.1,8.8.8.8
# One user (or VPN_USERS=user1:pass1,user2:pass2 for several).
VPN_USER=vpnuser
VPN_PASSWORD=
# VPN_USERS=user1:pass1,user2:pass2
# IPsec pre-shared key for L2TP clients (file-less login: IP + PSK + user/pass).
VPN_IPSEC_PSK=
# Bare L2TP WITHOUT IPsec (old stock router firmware, e.g. some Asus): 1 =
# allow. DANGER: logins AND all traffic go in CLEARTEXT. Default 0 refuses
# bare L2TP at packet level. Use only with a unique strong password.
# VPN_ALLOW_PLAIN_L2TP=0
