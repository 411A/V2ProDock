# Subscription URLs (comma/newline-separated lists accepted in BOTH vars).
# All sources are fetched in parallel and merged; dead URLs are skipped
# automatically, so list a fast local URL first plus public fallbacks.
# V2RayDAR fetches configs from public repos: https://github.com/411A/V2RayDAR
#
# IMPORTANT: Inside Docker, 127.0.0.1 refers to the container itself, NOT your host.
# Use one of these instead:
#   http://host.docker.internal:27141/subscription  (Docker 20.10+, works on Mac/Win/Linux)
#   http://192.168.x.x:27141/subscription           (your host's LAN IP)
#
# WSL2: install.sh auto-detects WSL2 and replaces host.docker.internal with
# the Windows host IP. No manual config needed.
SUBSCRIPTION_URL=

# Additional subscription URLs (merged with SUBSCRIPTION_URL, same format).
# One per line inside double quotes (dead URLs are skipped automatically) or one-line separated with comma:
# SUBSCRIPTION_URLS="http://192.168.x.x:27141/subscription.txt
# https://raw.githubusercontent.com/0xRadikal/Free-v2ray-Configs/main/top100.txt
# https://sub3.example/subscription"

# Ingest hygiene: Reality SNI plausibility is always checked. Set 1 for a
# DPI-hardened pool: also reject Shadowsocks and VMess/VLESS without TLS.
# Keep 0 for a general-purpose pool that intentionally serves every protocol.
# REQUIRE_TRANSPORT_SECURITY=0
# Optional operator-supplied Reality SNI denylist (comma-separated, *.suffix
# supported). No names are compiled into the daemon.
# SNI_DENYLIST=
# Optional allowlist for a host whose suffix is newer than the bundled public-
# suffix list (or intentionally private). Denylist still wins.
# SNI_ALLOWLIST=
# Strict optional DNS confirmation for Reality SNIs: reject only NXDOMAIN;
# timeout/SERVFAIL is inconclusive (a filtered resolver must not drop a node).
# SNI_DNS_CHECK=0

# URL used to test proxy connectivity (generate_204 or cp.cloudflare.com recommended)
HEALTH_CHECK_URL=https://www.gstatic.com/generate_204

# Race a Telegram-reachability leg into every probe (any HTTPS answer from
# api.telegram.org counts, even its 404 envelope): kills the false-healthy
# class where generic sites answer but Telegram's ASN is filtered.
TELEGRAM_PROBE=1
# TELEGRAM_PROBE=0 disables the third leg (two-leg 204 race only).

# No proxy bypass for internal/LAN IPs (prevents routing local subscription requests through proxy)
NO_PROXY=127.0.0.1,localhost,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# Number of xray instances to run
PROXY_INSTANCES=1

# Base port for proxy allocation: N SOCKS5 ports first, then N HTTP ports
# Instance i of N -> SOCKS5=PORT_BASE+i, HTTP=PORT_BASE+N+i
PORT_BASE=27019

# Port for the HTTP API (returns live proxy list)
API_PORT=27018

# Stable endpoints for bots / long-polling clients (Telegram gateways, scrapers):
# fixed ports that route EVERY connection to the fastest alive instance, so no
# config rewrite is ever needed when upstreams churn. 0 disables that protocol.
# Discovered at runtime via GET /health (aggregate_socks / aggregate_http).
AGGREGATE_SOCKS_PORT=27017
AGGREGATE_HTTP_PORT=27016

# Relay egress (opt-in second path: tunnel first, clean IP second).
# A STANDARD HTTP proxy (CONNECT + optional Basic auth) reached THROUGH the
# working upstream, so the censor sees only the tunnel while targets see the
# relay's clean egress IP. Served on its own stable SOCKS port (default :27015,
# 0 disables the port but keeps the feature parsed).
#   CF_RELAY_URL=http://user:pass@relay.example:8080
#   CF_RELAY_URL=https://you.workers.dev   (TLS to the relay, cert verified)
# Empty = off (zero behavior change). NOTE: a custom header-relay protocol
# (e.g. x-relay-target) is NOT enough — xray cannot speak it, the relay must
# answer CONNECT. See docs/CF_RELAY_WORKER.md for the contract + options.
# While the relay path is down its port fails fast; :27016/:27017 unaffected.
# CF_RELAY_URL=
# AGGREGATE_RELAY_PORT=27015

# Aggregate prefers candidates with this many consecutive successes (a slow
# node that holds 50s long-polls beats a fast one that RSTs them); fastest
# wins within the qualified tier, fastest overall when nothing qualifies.
# AGG_MIN_STREAK=3 (0 = pure lowest-latency)

# L2 escape hatch: when the censor blocks specific CDN edge IPs, map the dead
# dial address to a working anycast edge IP (SNI/Host/UUID untouched).
# Find the winner from the VM: ./scripts/cleanip-scan.sh <sni-host> 443
# CLEAN_IP_MAP="blocked.edge=104.17.42.7,203.0.113.9=104.21.64.64"

# Parallel probers per failover switch (1 = sequential). The old instance keeps
# serving while candidates are tested on throwaway ports; raising this finds a
# replacement faster at the cost of transient xray children (each ~15MB).
# SWITCH_WORKERS=3

# DPI-evasion TCP fragmentation for TLS upstreams (SNI-filtering networks):
# chains the dial via a fragment carrier (tlshello-only: cheapest effective).
# 1 = on (verified against Xray 26.x). Plaintext upstreams are never touched.
# MEASURED TRADE-OFF: fragment=1 is anti-RST but pro-throttle — some shapers
# fingerprint the split ClientHello, turning a 900KB/s node into 7KB/s. Only
# enable it where handshakes are actually RST; leave 0 elsewhere. The bulk
# throughput gate will demote nodes that collapse after enabling it.
# XRAY_FRAGMENT=0

# Per-socket TCP congestion control for the upstream dials. Empty = kernel
# default (usually cubic). On a lossy long-haul path, bbr usually turns
# "connects but stalls mid-download" into steady throughput. Checked against
# the kernel before rendering; an unavailable name is ignored with one warning.
# XRAY_TCP_CONGESTION=bbr

# Path to xray binary directory (default: /root/xray)
# XRAY_DIR=/root/xray

# Go garbage collector target percentage (lower = more frequent GC, less memory)
# GOGC=100

# Go soft memory limit (prevents OOM by triggering aggressive GC)
# GOMEMLIMIT=128MiB

# Max concurrent HTTP bridge handlers (CONNECT dial/hijack; whole plain-HTTP
# exchange). Live CONNECT tunnels are NOT counted against this; raise it for
# many parallel clients.
# MAX_CONNS=128

# Quality memos for upstream nodes that pass probes but are known to break
# large transfers (truncate at ~12KB, fail uploads, etc.). Comma-separated
# endpoint=memo pairs; no commas inside a memo. Memo'd nodes stay alive as the
# deliberate last resort but rank after every clean node, and /proxies shows
# memo/degraded. Endpoints are the host:port values printed by /proxies.
# PROXY_MEMOS="203.0.113.9:443=truncates >12KB; downloads/uploads fail"

# Bulk throughput gate. A 204 health probe measures handshake, not capacity;
# this fetches a real 4MiB body through each instance on promotion and every
# interval, scores the LAST 2 SECONDS (not the average), then demotes nodes
# below the floor through the same last-resort lane. Requires an
# operator-controlled object of at least 4MiB; speed-test endpoints are
# per-IP rate-limited and are deliberately not a default. 429/403/5xx from
# the target are inconclusive and never demote.
# THROUGHPUT_CHECK=1
# THROUGHPUT_FLOOR_KBPS=800          # 800 kbps ≈ 100 KB/s
# THROUGHPUT_INTERVAL_SECS=300
# THROUGHPUT_CHECK_BYTES=4194304     # 4 MiB; 64 KiB..16 MiB
# THROUGHPUT_TIMEOUT_SECS=45
# THROUGHPUT_CHECK_URL=https://your-static-host.example/probe.bin
# The URL may contain %d for the byte count, e.g. .../down?bytes=%d

# Upload-capability gate. A download probe cannot see a node that drops or
# stalls a request BODY: GET succeeds while POSTs fail. Point this at an
# endpoint you control that accepts a POST and returns 2xx only after reading
# the body (an echo endpoint is ideal). 16KiB per probe, same cadence as the
# bulk gate. Two consecutive conclusive failures mark the node upload-broken;
# one success restores it. A target-side rejection (4xx/5xx/redirect) is
# inconclusive and changes no node state. A broken/unknown node is NEVER
# removed: proven uploaders are ordered first only while at least one exists,
# otherwise the pool chooses its best downloader. Empty = gate idle.
# UPLOAD_CHECK=1
# UPLOAD_CHECK_URL=https://your-echo-host.example/post
# UPLOAD_CHECK_BYTES=16384           # 1 KiB..1 MiB
# UPLOAD_CHECK_TIMEOUT_SECS=20       # 5..120 s

# mux.cool on VMess/VLESS/Trojan outbounds (default 0). A measured experiment
# for ISPs that shape per TCP flow: it helps many parallel flows, cannot make a
# single bulk stream faster, and adds head-of-line risk. Compare throughput
# before/after; XTLS Vision and subscription-provided mux are left untouched.
# XRAY_MUX=0
# XRAY_MUX_CONCURRENCY=8

# Log level: info (default, only important logs) or debug (verbose + Xray logs)
# LOG_LEVEL=info
# Colors auto-disable without a TTY; force it explicitly if your log shipper
# chokes on ANSI escapes:
# NO_COLOR=1
# Steady-state policy (both services): healthy polls are silent, transitions
# log. Nothing to configure for that; these tune the gateway proof loop:
# POLL_SECS=15
# PROOF_HEARTBEAT_N=20
# EGRESS_URL=https://api.ipify.org

# --- IKEv2 + L2TP VPN gateway for legacy devices (Smart TVs, IoT, consoles) ---
# Single gateway on UDP 500/4500 (+1701 for L2TP). Client traffic is forced
# via tun0 into the fastest ALIVE Xray SOCKS (fail-closed: no direct egress).
# 0 = proxy-only (default, keeps old behavior). 1 = serve VPN.
VPN_ENABLED=0
# Public hostname/IP clients connect to (must match server cert; LAN IP ok).
# Connect using EXACTLY this name/IP (SAN-typed). Extra names/IPs (public +
# LAN) go in VPN_EXTRA_SANS so all of them validate.
VPN_DOMAIN=vpn.local
# VPN_EXTRA_SANS=203.0.113.7,192.168.1.10
# VPN client pools + pushed DNS (DNS also goes through the working proxy).
# Every DNS in the list is pushed (ms-dns); L2TP local/range must sit inside
# the /24 (boot refuses otherwise).
VPN_SUBNET=10.10.10.0/24
VPN_L2TP_NET=10.10.11.0/24
# VPN_L2TP_LOCAL=10.10.11.1
# VPN_L2TP_RANGE=10.10.11.10-10.10.11.100
VPN_DNS=1.1.1.1,8.8.8.8
# Gateway tunnel device/address (advanced; defaults fit Docker bridge MTU 1500).
# VPN_TUN_DEV=tun0
# VPN_TUN_ADDR=198.18.0.1
# One user (or VPN_USERS=user1:pass1,user2:pass2 for several).
VPN_USER=vpnuser
VPN_PASSWORD=
# VPN_USERS=user1:pass1,user2:pass2
# IPsec pre-shared key for L2TP clients (file-less login: IP + PSK + user/pass).
VPN_IPSEC_PSK=
# Bare L2TP WITHOUT IPsec (old stock router firmware, e.g. some Asus): 1 =
# allow. DANGER: logins AND all traffic go in CLEARTEXT. Default 0 refuses
# bare L2TP at packet level. Use only with a unique strong password.
# VPN_ALLOW_PLAIN_L2TP=0
# TCP MSS clamp for VPN client flows, both SYN directions (536-1460; 0 = off).
# 1360 fits IPsec/L2TP/PPTP overhead on a 1500-byte path. Without it, clients
# on PPPoE/smaller-MTU links can connect but stall on large downloads.
# VPN_MSS=1360
# PPTP for ANCIENT LAN devices only (e.g. MediaStar/Al-chipset satellite
# receivers whose VPN menu is just User + Password + encryption toggle:
# that menu is PPTP, SYN to TCP 1723). 1 = serve PPTP on TCP 1723 + GRE.
# WARNING: PPTP/MPPE is cryptographically BROKEN - keep the PPTP leg on a
# trusted LAN, NEVER expose 1723 to the internet. Internet egress still goes
# via the working Xray proxy (fail-closed). MPPE-128 is always mandatory
# when on; same VPN_USER/VPN_PASSWORD (or VPN_USERS) as IKEv2/L2TP.
# Needs GRE (IP proto 47): on a Linux host load nf_conntrack_pptp
# (install.sh does it) or use host networking if GRE stalls behind NAT.
# VPN_ENABLE_PPTP=0
# VPN_PPTP_NET=10.10.12.0/24
# VPN_PPTP_LOCAL=10.10.12.1
# VPN_PPTP_RANGE=10.10.12.10-10.10.12.100
