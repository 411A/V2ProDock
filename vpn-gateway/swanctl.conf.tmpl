# Rendered by entrypoint.sh - do not edit by hand.
# __VPN_DOMAIN__ __VPN_SUBNET__ __VPN_DNS__ replaced at boot.
# EAP users + L2TP PSK spliced at the markers below (literal, any chars safe).
connections {
  ikev2-eap {
    version = 2
    pools = vpn-pool
    local {
      auth = pubkey
      certs = server.crt
      id = __VPN_DOMAIN__
    }
    remote {
      auth = eap-mschapv2
      # EAP identity is the username; any peer may connect with valid creds.
      id = %any
    }
    children {
      net {
        local_ts = 0.0.0.0/0
        # Route everything (incl. DNS) through the tunnel so legacy
        # devices cannot leak around the working Xray configs.
        esp_proposals = aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024
        # Recycle DATA SAs every 30 min: a silently desynced child (IKE SA
        # alive, DPD blind) would otherwise blackhole one client until the
        # ~1h default lifetime expires. Rekey is routine for legacy stacks.
        rekey_time = 1800s
      }
    }
    # Broad proposals: modern first, legacy MODP1024/SHA1 last for old TVs/boxes.
    proposals = aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha1-modp2048,aes128-sha1-modp1024,aes256-sha256-modp1024
    dpd_delay = 30s
    rekey_time = 0s
    fragmentation = yes
    # Force UDP encapsulation (NAT-T) even without NAT: raw ESP (IP proto 50)
    # cannot traverse Docker's port NAT, so same-LAN clients and firewalls
    # that only pass TCP/UDP would break. Cost: 8 bytes overhead per packet.
    encap = yes
  }

  # L2TP/IPsec with PSK: file-less login for legacy devices
  # (server IP + IPsec PSK + PPP user/pass, no certificates).
  l2tp-psk {
    version = 1
    local_addrs = %any
    remote_addrs = %any
    local {
      auth = psk
    }
    remote {
      auth = psk
    }
    children {
      l2tp {
        mode = transport
        local_ts = 0.0.0.0/0[udp/1701]
        remote_ts = 0.0.0.0/0[udp]
        # DH variants first (PFS), plain variants after: IKEv1 QM has no
        # INVALID_KE retry, so DH-only would hard-fail legacy clients.
        esp_proposals = aes256-sha1-modp2048,aes128-sha1-modp2048,aes256-sha1,aes128-sha1,3des-sha1-modp1024,3des-sha1,aes256-sha256-modp2048
        dpd_action = clear
        # Same 30-min DATA-SA recycling as IKEv2 (bounds silent desync).
        rekey_time = 1800s
      }
    }
    # IKEv1 proposals: strong first, 3DES/MODP1024 last for ancient clients.
    proposals = aes256-sha1-modp2048,aes128-sha1-modp2048,3des-sha1-modp1024,aes256-sha256-modp2048
    dpd_delay = 30s
    rekey_time = 0s
    fragmentation = yes
    # Same as IKEv2: raw ESP cannot cross Docker port NAT (same-LAN clients)
    # or TCP/UDP-only firewalls - force UDP/4500 encapsulation.
    encap = yes
  }
}

pools {
  vpn-pool {
    addrs = __VPN_SUBNET__
    dns = __VPN_DNS__
  }
}

secrets {
  private {
    file = server.key
  }
  # __EAP_USERS__
  # __IPSEC_PSK__
}

# Trust anchor for validating peers (clients use the same section shape).
authorities {
  vpn-ca {
    cacert = ca.crt
  }
}
