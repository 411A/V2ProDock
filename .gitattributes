# Auto detect text files and perform LF normalization
* text=auto

# Go
*.go text diff=golang
go.mod text diff=golang
go.sum text diff=golang

# Shell scripts (excluded from language stats)
*.sh text eol=lf linguist-vendored

# Docker (excluded from language stats)
# eol=lf, not just `text`: a CRLF compose file breaks every $-anchored check
# in the test suite on a Windows checkout (it silently stops matching instead
# of failing loudly), and the installed stack is only ever run on Linux.
Dockerfile text diff=dockerfile linguist-vendored
docker-compose.yml text eol=lf linguist-vendored
*.yml text eol=lf linguist-vendored
*.yaml text eol=lf linguist-vendored

# Markdown (excluded from language stats)
*.md text diff=markdown linguist-vendored

# Config (excluded from language stats)
*.json text linguist-vendored
.env.example text eol=lf linguist-vendored

# VPN gateway templates: rendered into live configs at container boot, so
# they must stay tracked and visible (Dockerfile COPYs them - ignoring them
# would break every fresh clone/build). Excluded from language stats like
# the rest of the non-Go sources. LF enforced: a stray CR from a Windows
# checkout would silently break poptop/pppd parsing (proven failure mode).
*.tmpl text eol=lf linguist-vendored

# Binary
*.exe binary
*.zip binary
xray/* binary

# Enforce LF line endings for shell scripts
*.sh text eol=lf
